@model ERP_GMEDINA.Models.tbCatalogoDePlanillas

@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}
<link href="~/Content/plugins/awesome-bootstrap-checkbox/awesome-bootstrap-checkbox.css" rel="stylesheet" />
@*<link href="css/plugins/awesome-bootstrap-checkbox/awesome-bootstrap-checkbox.css" rel="stylesheet">*@
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>Crear</h2>
        <ol class="breadcrumb">
            <li class="active">
                <strong>Crear una nueva planilla con sus ingresos y deducciones</strong>
            </li>
        </ol>
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    @Html.ActionLink("Regresar", "Index", null, new { @class = "pull-right" })
                    <h2>Crear</h2>
                </div>


                @using (Html.BeginForm())
                {
                    <div class="ibox-content">
                        @Html.AntiForgeryToken()
                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.cpla_IdPlanilla)

                            <div class="form-group">
                                @Html.LabelFor(model => model.cpla_DescripcionPlanilla, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.cpla_DescripcionPlanilla, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.cpla_DescripcionPlanilla, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.cpla_FrecuenciaEnDias, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.cpla_FrecuenciaEnDias, new { htmlAttributes = new { @class = "form-control", @pattern = "[0-9]" } })
                                    @Html.ValidationMessageFor(model => model.cpla_FrecuenciaEnDias, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <br />
                    <div class="col-lg-5" id="catalogoDeIngresos">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>Lista del catalogo de Ingresos</h5>
                            </div>
                            <div class="ibox-content">
                                @foreach (var item in ViewBag.CatalogoIngresos)
                                {
                                    <div class="form-horizontal col-xs-offset-1">
                                        <div class="form-group">
                                            <input type="checkbox" class="i-checks" id="check-@item.id" checked /> @item.descripcion
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-5" id="catalogoDeDeducciones">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>Lista del catalogo de Deducciones</h5>
                            </div>
                            <div class="ibox-content">

                                @foreach (var item in ViewBag.CatalogoDeducciones)
                                {
                                    <div class="form-horizontal col-xs-offset-1">
                                        <div class="form-group">
                                            <input type="checkbox" class="i-checks" id="check-@item.id" checked /> @item.descripcion
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="button" id="btnGuardarCatalogoDePlanillasIngresosDeducciones" value="Guardar" class="btn btn-primary" />
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/Scripts_Base/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/app/General/CatalogoPlanillas.js"></script>
<script src="~/Scripts/plugins/iziToast/iziToast.js"></script>

@section Scripts {
    @Scripts.Render("~/plugins/iCheck")
}
@section Styles {
    @Styles.Render("~/Content/plugins/izitoast/iziToast")
}




<link href="~/Content/plugins/iCheck/custom.css" rel="stylesheet" />

<script>
    $(document).ready(function () {
        $('.i-checks').iCheck({
            checkboxClass: 'icheckbox_square-green',
            radioClass: 'iradio_square-green',
        });
    });
</script>


