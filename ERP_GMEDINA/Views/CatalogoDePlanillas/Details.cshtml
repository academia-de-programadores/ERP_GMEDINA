@model ERP_GMEDINA.Models.tbCatalogoDePlanillas

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="col-lg-12">
    <div class="ibox float-e-margins">
        <div class="ibox-title">
            @Html.ActionLink("Regresar", "Index", null, new { @class = "pull-right" })
            <h2>Details</h2>
        </div>

        <div class="ibox-content">
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.cpla_DescripcionPlanilla)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.cpla_DescripcionPlanilla)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.cpla_FrecuenciaEnDias)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.cpla_FrecuenciaEnDias)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.cpla_FechaCrea)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.cpla_FechaCrea)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.cpla_FechaModifica)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.cpla_FechaModifica)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.tbUsuario.usu_NombreUsuario)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.tbUsuario.usu_NombreUsuario)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.tbUsuario1.usu_NombreUsuario)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.tbUsuario1.usu_NombreUsuario)
                </dd>

            </dl>
            <p>
                @Html.ActionLink("Editar", "Edit", new { id = Model.cpla_IdPlanilla }, new { @class = "btn btn-primary" })
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
            </p>
        </div>
    </div>
</div>
<div class="ibox float-e-margins">
    <div class="ibox-title">
        <h2>Auditoría</h2>
    </div>
    <div class="ibox-content">
        <div class="form-horizontal">
            <table class="table table-striped table-bordered dataTable">
                <thead>
                    <tr>
                        <th>Acción</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Creado</td>
                        <td>@Html.DisplayFor(model => model.tbUsuario.usu_Nombres)</td>
                        <td>@Html.DisplayFor(model => model.cpla_FechaCrea)</td>
                    </tr>
                    <tr>
                        <td>Modificado</td>
                        <td>@Html.DisplayFor(model => model.tbUsuario1.usu_Nombres)</td>
                        <td>@Html.DisplayFor(model => model.cpla_FechaCrea)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>