@model IEnumerable<ERP_GMEDINA.Models.tbCatalogoDePlanillas>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="float-e-margins">
                <div class="ibox-title">
                    <h5>Catalogo de Planillas</h5>
                    <div class="ibox-tools">
                        @Html.ActionLink("Registrar Planillas", "Create", null, new { @class = "btn btn-primary btn-xs" })
                    </div>
                </div>
                <div class="ibox-content">
                    <div id="detalles" style="display:none">
                        @foreach (var item in Model)
                        {
                            if (item.cpla_Activo == true)
                            {
                                <div id="fila-@item.cpla_IdPlanilla">
                                    @Html.Partial("_IndexTipoPlanillaDetalleIngreso", item.tbTipoPlanillaDetalleIngreso, new ViewDataDictionary { { "idDetalleIngreso", item.cpla_IdPlanilla } })
                                    @Html.Partial("_IndexTipoPlanillaDetalleDeduccion", item.tbTipoPlanillaDetalleDeduccion, new ViewDataDictionary { { "idDetalleDeduccion", item.cpla_IdPlanilla } })
                                </div>
                            }
                        }
                    </div>
                    <table class="table table-striped table-bordered table-hover dataTables-example" id="tblCatalogoPlanillas">
                        <thead>
                            <tr role="row">
                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending" style="width: 128px;"></th>
                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending" style="width: 128px;">@Html.DisplayNameFor(model => model.cpla_DescripcionPlanilla)</th>
                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending" style="width: 128px;">@Html.DisplayNameFor(model => model.cpla_FrecuenciaEnDias)</th>
                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending" style="width: 128px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                if (item.cpla_Activo == true)
                                {
                                    <tr class="gradeA odd" role="row" data-id="@item.cpla_IdPlanilla">
                                        <td width="5%">
                                            <button class="btn btn-primary btn-xs center-block" id="btnDesplegarIngresosDeducciones">+</button>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.cpla_DescripcionPlanilla)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.cpla_FrecuenciaEnDias)
                                        </td>
                                        <td class="pull-right">
                                            @Html.ActionLink("Detalles", "Details", new { id = item.cpla_IdPlanilla }, new { @class = "btn btn-default btn-xs" })
                                            @Html.ActionLink("Editar", "Edit", new { id = item.cpla_IdPlanilla }, new { @class = "btn btn-primary btn-xs" })
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr role="row">
                                <th></th>
                                <th rowspan="1" colspan="1">@Html.DisplayNameFor(model => model.cpla_DescripcionPlanilla)</th>
                                <th rowspan="1" colspan="1">@Html.DisplayNameFor(model => model.cpla_FrecuenciaEnDias)</th>
                                <th>Acción</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/Scripts/app/general/CatalogoPlanillas")
}
