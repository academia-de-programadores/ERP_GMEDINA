@model ERP_GMEDINA.Models.tbCatalogoDePlanillas

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="ibox-title">
	@Html.ActionLink("Regresar", "Index", null, new {@class="pull-right" })
	<h2>Editar</h2>
</div>


<div class="ibox-content">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.cpla_IdPlanilla)

        <div class="form-group">
            @Html.LabelFor(model => model.cpla_DescripcionPlanilla, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.cpla_DescripcionPlanilla, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.cpla_DescripcionPlanilla, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.cpla_FrecuenciaEnDias, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.cpla_FrecuenciaEnDias, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.cpla_FrecuenciaEnDias, "", new { @class = "text-danger" })
            </div>
        </div>

        <br />
        <div class="col-lg-5" id="catalogoDeIngresos">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Lista del catalogo de Ingresos</h5>
                </div>
                <div class="ibox-content">
                    @foreach (var item in ViewBag.CatalogoIngresos)
                    {
                        <div class="form-horizontal">
                            <div class="form-group">
                                <input type="checkbox" class="custom-control-input" id="check-@item.id" checked="@item.check" /> @item.descripcion
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>


        <div class="col-lg-5" id="catalogoDeDeducciones">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Lista del catalogo de Deducciones</h5>
                </div>
                <div class="ibox-content">

                    @foreach (var item in ViewBag.CatalogoDeducciones)
                    {
                        <div class="form-horizontal">
                            <div class="form-group">
                                <input type="checkbox" class="custom-control-input" id="check-@item.id" checked="@item.check" /> @item.descripcion
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="button" id="btnEditarCatalogoDePlanillasIngresosDeducciones" value="Editar" class="btn btn-primary" />
				@Html.ActionLink("Cancelar", "Index", null, new { @class="btn btn-default"})
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-11">
        <div class="form-horizontal">
            <div class="form-group">
                <button class="btn btn-danger btn-lg pull-right" id="inactivar">Inactivar</button>
            </div>
        </div>
    </div>
</div>
<div class="ibox float-e-margins">
    <div class="ibox-title">
        <h2>Auditoría</h2>
    </div>
    <div class="ibox-content">
        <div class="form-horizontal">
            <table class="table table-striped table-bordered dataTable">
                <thead>
                    <tr>
                        <th>Acción</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Creado</td>
                        <td>@Html.DisplayFor(model => model.tbUsuario.usu_Nombres)</td>
                        <td>@Html.DisplayFor(model => model.cpla_FechaCrea)</td>
                    </tr>
                    <tr>
                        <td>Modificado</td>
                        <td>@Html.DisplayFor(model => model.tbUsuario1.usu_Nombres)</td>
                        <td>@Html.DisplayFor(model => model.cpla_FechaCrea)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
}
</div>
@* TOOD: Renderizar scripts de una buena manera aqui *@
<script src="~/Scripts/Scripts_Base/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/app/General/CatalogoPlanillas.js"></script>